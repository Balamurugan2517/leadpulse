# ==============================================================================
# LeadPulse AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real secrets.

# --- Application Runtime ---
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# --- Authentication (Better Auth) ---
BETTER_AUTH_SECRET=your_generated_32_character_secret_here
BETTER_AUTH_URL=http://localhost:3000

# --- Database (Neon PostgreSQL) ---
# Direct TCP Connection (Used by Worker & Database Migrations)
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/leadpulse?sslmode=require

# Pooled Serverless Connection (Used by Next.js Server Actions & API Routes)
DATABASE_URL_UNPOOLED=postgres://user:password@ep-sample.us-east-2.aws.neon.tech/leadpulse?sslmode=require

# --- Background Worker ---
WORKER_POLL_INTERVAL_MS=3000
WORKER_CONCURRENCY=2
WORKER_HEADLESS=true

# --- AI Integration (Optional OpenRouter) ---
# Keep empty if running in rule-based / template mode
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-chat
OPENROUTER_ZDR_ENABLED=true
AI_MONTHLY_BUDGET_USD=25.00

# --- External API Connectors (Optional - Default: disabled/manual) ---
GOOGLE_PLACES_API_KEY=
META_APP_ID=
META_APP_SECRET=
X_API_BEARER_TOKEN=
YOUTUBE_DATA_API_KEY=

# --- Security & SSRF Protection ---
AUDIT_ALLOWED_PORTS=80,443
AUDIT_TIMEOUT_MS=15000
AUDIT_MAX_REDIRECTS=5
